{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CaptureGate image Lambda; IAM-only URL. Requires explicit deployment authorization.",
  "Parameters": {
    "ImageUri": {
      "Type": "String",
      "Description": "Existing private ECR image URI built for linux/amd64"
    }
  },
  "Resources": {
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "MinimalLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 3
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "PackageType": "Image",
        "Code": {
          "ImageUri": {
            "Ref": "ImageUri"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Architectures": [
          "x86_64"
        ],
        "MemorySize": 1024,
        "Timeout": 15,
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "Logs"
          }
        },
        "Environment": {
          "Variables": {
            "OPENCV_IO_MAX_IMAGE_PIXELS": "16000000"
          }
        }
      }
    },
    "Url": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "Function"
        },
        "AuthType": "AWS_IAM"
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "Function"
      }
    },
    "IamOnlyUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Url",
          "FunctionUrl"
        ]
      }
    }
  }
}
